<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1808" pageHeight="752" math="1" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="单个 Episode：短复位 → 直接定位 → 连续抓放 → 立即结束" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#000000;fontSize=24;fontFamily=Microsoft YaHei,SimSun;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="1"><mxGeometry x="32" y="24" width="880" height="40" as="geometry"/></mxCell><mxCell id="3" value="① 录制前检查&lt;br&gt;杯位属于计划分组&lt;br&gt;双相机清晰且同步&lt;br&gt;机械臂处于标准起点" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=2;fontColor=#000000;fontSize=15;fontFamily=Microsoft YaHei,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="40" y="112" width="184" height="136" as="geometry"/></mxCell><mxCell id="4" value="② 开始录制&lt;br&gt;短暂稳定 0.3–0.5 s&lt;br&gt;随后立即开始运动&lt;br&gt;禁止长静止前缀" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=2;fontColor=#000000;fontSize=15;fontFamily=Microsoft YaHei,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="256" y="112" width="184" height="136" as="geometry"/></mxCell><mxCell id="5" value="③ 定位与接近&lt;br&gt;第一下就朝杯子方向&lt;br&gt;连续、缓慢、少修正&lt;br&gt;腕部画面保持杯子可见" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontColor=#000000;fontSize=15;fontFamily=Microsoft YaHei,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="472" y="112" width="184" height="136" as="geometry"/></mxCell><mxCell id="6" value="④ 闭爪&lt;br&gt;对准后连续闭合&lt;br&gt;不反复开合&lt;br&gt;记录三路力反馈" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontColor=#000000;fontSize=15;fontFamily=Microsoft YaHei,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="688" y="112" width="184" height="136" as="geometry"/></mxCell><mxCell id="7" value="⑤ 稳定闭爪&lt;br&gt;保持 0.2–0.5 s&lt;br&gt;确认夹持稳定&lt;br&gt;保持夹爪命令连续" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;fontColor=#000000;fontSize=15;fontFamily=Microsoft YaHei,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="904" y="112" width="184" height="136" as="geometry"/></mxCell><mxCell id="8" value="⑥ 抬升与搬运&lt;br&gt;先垂直抬起 3–5 cm&lt;br&gt;再平稳移动到放置区&lt;br&gt;途中不得重新张爪" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=2;fontColor=#000000;fontSize=15;fontFamily=Microsoft YaHei,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="112" width="184" height="136" as="geometry"/></mxCell><mxCell id="9" value="⑦ 放下与释放&lt;br&gt;杯底接触桌面&lt;br&gt;松爪并停 0.2–0.5 s&lt;br&gt;再安全撤离" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=2;fontColor=#000000;fontSize=15;fontFamily=Microsoft YaHei,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1336" y="112" width="184" height="136" as="geometry"/></mxCell><mxCell id="10" value="⑧ 结束审核&lt;br&gt;成功后尽快停止&lt;br&gt;禁止末尾长静止&lt;br&gt;失败整段重录" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontColor=#000000;fontSize=14;fontFamily=Microsoft YaHei,SimSun;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1552" y="112" width="176" height="136" as="geometry"/></mxCell><mxCell id="11" value="保留条件（全部满足）&lt;br&gt;✓ 任务完整成功且无洒水/掉杯&lt;br&gt;✓ 首动作方向正确，无先去中间再追踪&lt;br&gt;✓ 抓起—搬运—放下连续，无明显抽搐&lt;br&gt;✓ 两路画面无掉帧/遮挡失效&lt;br&gt;✓ action.target 与 observation.state 时间对齐" style="shape=document;boundedLbl=1;html=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontColor=#000000;fontSize=18;fontFamily=Microsoft YaHei,SimSun;verticalAlign=middle;align=left" vertex="1" parent="1"><mxGeometry x="152" y="352" width="648" height="224" as="geometry"/></mxCell><mxCell id="12" value="立即判废（出现任一项）&lt;br&gt;✗ 长时间静止、暂停思考、动作分段&lt;br&gt;✗ 失败后在同一段内重新抓取或人为移动杯子&lt;br&gt;✗ 夹爪反复开合、抓后松杯、明显碰撞或抽搐&lt;br&gt;✗ 杯子/夹爪长期出画，曝光突变或视频卡顿&lt;br&gt;✗ 状态、动作、相机帧数或时间戳不一致" style="shape=document;boundedLbl=1;html=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;fontColor=#000000;fontSize=18;fontFamily=Microsoft YaHei,SimSun;verticalAlign=middle;align=left" vertex="1" parent="1"><mxGeometry x="960" y="352" width="648" height="224" as="geometry"/></mxCell><mxCell id="13" value="记录语义：action = 限幅后实际发送目标；state = 从臂实际反馈；主臂信号仅诊断，不作为策略部署输入。" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#000000;fontSize=18;fontFamily=Microsoft YaHei,SimSun;align=center;verticalAlign=top;fontStyle=1" vertex="1" parent="1"><mxGeometry x="184" y="632" width="1392" height="40" as="geometry"/></mxCell><mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2.5;endArrow=open;endFill=0;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2.5;endArrow=open;endFill=0;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2.5;endArrow=open;endFill=0;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2.5;endArrow=open;endFill=0;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2.5;endArrow=open;endFill=0;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="7" target="8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2.5;endArrow=open;endFill=0;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="8" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2.5;endArrow=open;endFill=0;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="9" target="10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel>
  </diagram>
